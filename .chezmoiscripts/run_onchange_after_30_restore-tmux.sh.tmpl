#!/bin/sh

set -eu

{{ include ".chezmoitemplates/restore-ui.sh" }}

# tmux config: {{ include "dot_config/tmux/tmux.conf.tmpl" | sha256sum }}
# tmux theme: {{ include "dot_config/tmux/themes/vira-graphene.conf" | sha256sum }}
# plugin lock: {{ include "dot_config/tmux/plugins.lock" | sha256sum }}
# which-key config: {{ include "dot_config/tmux/tmux-which-key/config.yaml.tmpl" | sha256sum }}
# which-key setup: {{ include "dot_config/tmux/tmux-which-key/executable_setup.sh" | sha256sum }}

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
tmux_dir="$config_home/tmux"
tmux_conf="$tmux_dir/tmux.conf"
lock_file="$tmux_dir/plugins.lock"
plugin_root="$tmux_dir/plugins"

ui_init
ui_prepare_log tmux
ui_title "tmux restore"

ui_step "Checking prerequisites"
missing=""
for command_name in awk cut eza fzf git python3 sesh sort tmux tr zoxide; do
    command -v "$command_name" >/dev/null 2>&1 || missing="$missing $command_name"
done
[ -z "$missing" ] || ui_die "Missing required commands:$missing"
if [ -n "${SHELL:-}" ] && [ ! -x "$SHELL" ]; then
    ui_die "SHELL is not executable: $SHELL"
fi
ui_ok "Prerequisites"

[ -f "$tmux_conf" ] || ui_die "Missing $tmux_conf"
[ -f "$lock_file" ] || ui_die "Missing $lock_file"
[ -x "$tmux_dir/tmux-which-key/setup.sh" ] || ui_die "Missing executable tmux-which-key/setup.sh"

ui_step "Validating plugin lock"
locked=$(awk 'NF == 2 && $1 !~ /^#/ { print $1 }' "$lock_file" | LC_ALL=C sort)
declared=$(awk '$1 == "set" && $2 == "-g" && $3 == "@plugin" { print $4 }' "$tmux_conf" | tr -d "'\"" | LC_ALL=C sort)
[ "$locked" = "$declared" ] || {
    printf 'declared:\n%s\nlocked:\n%s\n' "$declared" "$locked" > "$UI_LOG_FILE"
    ui_die_log "tmux.conf and plugins.lock disagree"
}
plugin_count=$(awk 'NF == 2 && $1 !~ /^#/ { count++ } END { print count + 0 }' "$lock_file")
ui_ok "Lock aligned · $plugin_count plugins"

mkdir -p "$plugin_root"
while read -r repository revision extra; do
    case "$repository" in
        ''|'#'*) continue ;;
    esac
    [ -z "${extra:-}" ] || ui_die "Invalid plugins.lock row for $repository"
    case "$revision" in
        *[!0-9a-f]*|'') ui_die "Invalid revision for $repository" ;;
    esac
    [ "${#revision}" -eq 40 ] || ui_die "Revision for $repository must be a full commit SHA"

    # tmux-which-key owns additional config linking and menu generation, so its
    # reusable setup helper owns the checkout as well.
    [ "$repository" = "alexwforsythe/tmux-which-key" ] && continue

    plugin_name=${repository##*/}
    plugin_dir="$plugin_root/$plugin_name"
    expected_url="https://github.com/$repository.git"
    short_revision=$(printf '%s' "$revision" | cut -c1-7)
    ui_step "$plugin_name @ $short_revision"

    if [ ! -d "$plugin_dir/.git" ]; then
        [ ! -e "$plugin_dir" ] || ui_die "$plugin_dir exists but is not a Git checkout"
        git clone "$expected_url" "$plugin_dir" >> "$UI_LOG_FILE" 2>&1 || ui_die_log "Failed to clone $repository"
    else
        origin=$(git -C "$plugin_dir" remote get-url origin 2>> "$UI_LOG_FILE") || ui_die_log "Failed to read origin for $plugin_name"
        case "$origin" in
            "$expected_url"|"https://github.com/$repository"|"git@github.com:$repository.git") ;;
            *) ui_die "$plugin_dir has unexpected origin: $origin" ;;
        esac
    fi

    git -C "$plugin_dir" diff --quiet || ui_die "$plugin_dir has modified tracked files"
    git -C "$plugin_dir" diff --cached --quiet || ui_die "$plugin_dir has staged changes"
    if ! git -C "$plugin_dir" cat-file -e "$revision^{commit}" 2>/dev/null; then
        git -C "$plugin_dir" fetch origin >> "$UI_LOG_FILE" 2>&1 || ui_die_log "Failed to fetch $repository"
    fi
    git -C "$plugin_dir" checkout --quiet --detach "$revision" >> "$UI_LOG_FILE" 2>&1 || ui_die_log "Failed to checkout $plugin_name"
    git -C "$plugin_dir" submodule update --init --recursive >> "$UI_LOG_FILE" 2>&1 || ui_die_log "Failed to initialize $plugin_name submodules"
    ui_ok "$plugin_name"
done < "$lock_file"

ui_step "Building WhichKey menu"
TMUX_WHICH_KEY_SKIP_RELOAD=1 \
    "$tmux_dir/tmux-which-key/setup.sh" >> "$UI_LOG_FILE" 2>&1 || ui_die_log "Failed to build WhichKey menu"
ui_ok "WhichKey menu"

if tmux list-sessions >/dev/null 2>&1; then
    tmux source-file "$tmux_conf" >> "$UI_LOG_FILE" 2>&1 || ui_die_log "Failed to reload the live tmux server"
    ui_ok "Live server reloaded"
else
    ui_warn "No running server; applies on next start"
fi

ui_done "tmux ready · $plugin_count plugins"
