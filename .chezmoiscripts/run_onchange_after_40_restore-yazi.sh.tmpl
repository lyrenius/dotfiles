#!/bin/sh

set -eu

# Yazi package lock: {{ include "dot_config/yazi/package.toml" | sha256sum }}

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
yazi_home="$config_home/yazi"
package_file="$yazi_home/package.toml"

fail() {
    printf 'Yazi restore: %s\n' "$*" >&2
    exit 1
}

missing=""
for command_name in awk ya yazi; do
    command -v "$command_name" >/dev/null 2>&1 || missing="$missing $command_name"
done
[ -z "$missing" ] || fail "missing required commands:$missing"
[ -f "$package_file" ] || fail "missing $package_file"

yazi_version=$(yazi --version | awk '/Version:/ { print $2; exit }')
ya_version=$(ya --version | awk '/Version:/ { print $2; exit }')
[ -n "$yazi_version" ] || fail "could not determine Yazi version"
[ "$yazi_version" = "$ya_version" ] || fail "Yazi ($yazi_version) and Ya ($ya_version) versions differ"

YAZI_CONFIG_HOME="$yazi_home" ya pkg install

awk -F '"' '/^use = / { print $2 }' "$package_file" | while read -r dependency; do
    plugin_name=${dependency##*:}
    [ -f "$yazi_home/plugins/$plugin_name.yazi/main.lua" ] || fail "plugin was not restored: $plugin_name"
done

printf 'YAZI_RESTORE=PASS version=%s\n' "$yazi_version"
