    "barrett": {
        "prefix": "barrett",
        "body": [
            "struct barrett {",
            "    int64_t p, m;",
            "    constexpr barrett(int64_t p) : p(p), m((__int128_t(1) << 64) / p) {}",
            "    constexpr int64_t operator()(int64_t x) const {",
            "        x -= ((__int128_t(x) * m) >> 64) * p;",
            "        return x >= p ? x - p : x;",
