{{- $defaultShell := env "SHELL" -}}
{{- if not $defaultShell -}}
{{- $defaultShell = lookPath "sh" -}}
{{- end -}}
# Modern tmux configuration for Ghostty, LazyVim, macOS, and Linux.

# Terminal capabilities
set -g default-terminal "tmux-256color"
set -as terminal-features ",xterm-ghostty:RGB:clipboard:focus:extkeys:hyperlinks:osc7"
set -s extended-keys on
# Older tmux releases do not expose this selector; keep their native format.
set -s -q extended-keys-format csi-u
set -g focus-events on
set -sg escape-time 0
set -s set-clipboard on
set -g allow-passthrough on
set -ga update-environment TERM
set -ga update-environment TERM_PROGRAM

# General behavior
set-environment -g TMUX_PLUGIN_MANAGER_PATH "{{ joinPath .chezmoi.homeDir ".config/tmux/plugins" }}/"
set -g default-shell "{{ $defaultShell }}"
set -g mouse on
set -g history-limit 100000
set -g display-time 2000
set -g repeat-time 500
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on
set -g detach-on-destroy off
set -g set-titles on
set -g set-titles-string "#S:#I.#P #{pane_current_command}"
setw -g automatic-rename on
setw -g automatic-rename-format "#{b:pane_current_path}"
setw -g mode-keys vi
set -g status-keys vi

# Ctrl-q opens the discoverable leader menu. Ctrl-b remains the native fallback prefix.
# Remove the previous root-table binding so Ctrl-a reaches the active program.
unbind-key -q -T root C-a
set -g prefix C-b
bind-key C-b send-prefix

# Windows and panes inherit the active pane's working directory.
unbind-key -q '"'
unbind-key -q '%'
bind-key '|' split-window -h -c "#{pane_current_path}"
bind-key '-' split-window -v -c "#{pane_current_path}"
bind-key c new-window -c "#{pane_current_path}"

# Prefix-based pane navigation and repeatable resizing.
bind-key h select-pane -L
bind-key j select-pane -D
bind-key k select-pane -U
bind-key l select-pane -R
bind-key -r H resize-pane -L 3
bind-key -r J resize-pane -D 3
bind-key -r K resize-pane -U 3
bind-key -r L resize-pane -R 3
bind-key z resize-pane -Z

# Reload this configuration.
bind-key r source-file ~/.config/tmux/tmux.conf \; display-message "tmux config reloaded"

# Vi-style copy mode with a native macOS clipboard fallback.
bind-key -T copy-mode-vi v send-keys -X begin-selection
bind-key -T copy-mode-vi C-v send-keys -X rectangle-toggle
if-shell 'command -v pbcopy >/dev/null 2>&1' {
    bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel 'pbcopy'
} {
    bind-key -T copy-mode-vi y send-keys -X copy-selection-and-cancel
}

# Native-prefix fallbacks for session and window pickers.
if-shell 'command -v sesh >/dev/null 2>&1' {
    bind-key s display-popup -E -w 80% -h 70% -d "#{pane_current_path}" -T " Sessions " 'sesh picker -i'
    bind-key L run-shell 'sesh last'
} {
    bind-key s choose-tree -Zs
    bind-key L switch-client -l
}
bind-key w choose-tree -Zw

# Vira Graphene UI. Resolve relative to the final XDG config location.
source-file -q ~/.config/tmux/themes/vira-graphene.conf

# Community integrations. TPM must remain the final executed component.
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'mrjones2014/smart-splits.nvim'
set -g @plugin 'tmux-plugins/tmux-cpu'
set -g @plugin 'alexwforsythe/tmux-which-key'
set -g @plugin 'tmux-plugins/tmux-resurrect'

set -g @smart-splits_no_wrap '1'

set -g @cpu_low_fg_color '#[fg=#C3E88D]'
set -g @cpu_medium_fg_color '#[fg=#BD9855]'
set -g @cpu_high_fg_color '#[fg=#B2595E]'
set -g @cpu_low_bg_color '#[bg=default]'
set -g @cpu_medium_bg_color '#[bg=default]'
set -g @cpu_high_bg_color '#[bg=default]'
set -g @cpu_low_icon ''
set -g @cpu_medium_icon ''
set -g @cpu_high_icon ''
set -g @cpu_percentage_format '%3.0f%%'
set -g @cpu_medium_thresh '50'
set -g @cpu_high_thresh '80'

set -g @ram_low_fg_color '#[fg=#C3E88D]'
set -g @ram_medium_fg_color '#[fg=#BD9855]'
set -g @ram_high_fg_color '#[fg=#B2595E]'
set -g @ram_low_bg_color '#[bg=default]'
set -g @ram_medium_bg_color '#[bg=default]'
set -g @ram_high_bg_color '#[bg=default]'
set -g @ram_low_icon ''
set -g @ram_medium_icon ''
set -g @ram_high_icon ''
set -g @ram_percentage_format '%3.0f%%'
set -g @ram_medium_thresh '65'
set -g @ram_high_thresh '85'

set -g @tmux-which-key-disable-autobuild '0'

set -g @resurrect-dir '~/.local/state/tmux/resurrect'
set -g @resurrect-capture-pane-contents 'off'

if-shell '[ -x ~/.config/tmux/plugins/tpm/tpm ]' {
    run-shell '~/.config/tmux/plugins/tpm/tpm'
}
