# Login-shell integrations and PATH additions.
if [[ "$OSTYPE" == darwin* && -r "$ZDOTDIR/platforms/darwin/profile.zsh" ]]; then
  source "$ZDOTDIR/platforms/darwin/profile.zsh"
fi

# Expose mise-managed tools to login shells via shims
if (( $+commands[mise] )); then
  eval "$(mise activate zsh --shims)"
fi

# Keep user wrappers first after Homebrew and toolchain PATH setup.
typeset -U path PATH
path=("$HOME/.local/bin" $path)
export PATH
