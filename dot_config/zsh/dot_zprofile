# Login shells only. On macOS, /etc/zprofile runs path_helper before this
# file and moves the system directories ahead of everything .zshenv added.

if [[ "$OSTYPE" == darwin* && -r "$ZDOTDIR/platforms/darwin/profile.zsh" ]]; then
  source "$ZDOTDIR/platforms/darwin/profile.zsh"
fi

# mise shims expose managed tools to programs started from a login shell.
# Interactive shells additionally run `mise activate` (integrations/80-mise.zsh).
if (( $+commands[mise] )); then
  eval "$(mise activate zsh --shims)"
fi

# path_helper, Homebrew, and mise all prepend to PATH; put user wrappers back
# in front of them.
typeset -U path PATH
path=("$HOME/.local/bin" $path)
export PATH
