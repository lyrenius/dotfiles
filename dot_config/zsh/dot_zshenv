# XDG base directories. Keep this file limited to environment and path setup;
# it is sourced by every zsh invocation, including non-interactive shells.
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"

# Tool homes.
export CARGO_HOME="$XDG_DATA_HOME/cargo"
export RUSTUP_HOME="$XDG_DATA_HOME/rustup"
export DOCKER_CONFIG="$XDG_CONFIG_HOME/docker"
export NPM_CONFIG_CACHE="$XDG_CACHE_HOME/npm"
export NPM_CONFIG_USERCONFIG="$XDG_CONFIG_HOME/npm/npmrc"
export GROK_HOME="$XDG_DATA_HOME/grok"
export CLAUDE_CONFIG_DIR="$XDG_DATA_HOME/claude"
export COPILOT_HOME="$XDG_DATA_HOME/copilot"
export CODEX_HOME="$XDG_DATA_HOME/codex"

# Persistent shell state and generated caches.
export HISTFILE="$XDG_STATE_HOME/zsh/history"
export ZSH_COMPDUMP="$XDG_CACHE_HOME/zsh/zcompdump-${HOST}-${ZSH_VERSION}"
export ZSH_CACHE_DIR="$XDG_CACHE_HOME/oh-my-zsh"
# Powerlevel10k has no setting for its cache location: it always writes
# $XDG_CACHE_HOME/p10k-{dump,instant-prompt}-$USER.zsh, read in .zshrc.

# User-wide command defaults.
export EDITOR="nvim"
export LANG="en_US.UTF-8"

# Keep user wrappers, Rust proxies, and cargo-installed binaries available without duplicating
# entries each time a nested shell starts.
typeset -U path PATH
path=(
  "$HOME/.local/bin"
  "$CARGO_HOME/bin"
  $path
)

# Platform-specific environment setup stays separate from shared defaults.
if [[ "$OSTYPE" == darwin* && -r "$ZDOTDIR/platforms/darwin/env.zsh" ]]; then
  source "$ZDOTDIR/platforms/darwin/env.zsh"
fi
export PATH
