{{- if .restore.neovim -}}
#!/bin/sh

set -eu

{{ include ".chezmoitemplates/restore-ui.sh" }}

# Neovim lock: {{ include "dot_config/nvim/lazy-lock.json" | sha256sum }}
# Lazy bootstrap: {{ include "dot_config/nvim/lua/config/lazy.lua" | sha256sum }}
# LazyVim profile: {{ include "dot_config/nvim/lazyvim.json" | sha256sum }}
# Editor bootstrap guard: {{ include "dot_config/nvim/lua/plugins/editor.lua" | sha256sum }}
# Formatting bootstrap guard: {{ include "dot_config/nvim/lua/plugins/formatting.lua" | sha256sum }}

ui_init
ui_prepare_log neovim
ui_title "Neovim restore"

ui_step "Checking prerequisites"
missing=""
for command_name in cc git make nvim python3; do
    command -v "$command_name" >/dev/null 2>&1 || missing="$missing $command_name"
done
[ -z "$missing" ] || ui_die "Missing required commands:$missing"
ui_ok "Prerequisites"

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
data_home=${XDG_DATA_HOME:-"$HOME/.local/share"}
lock_file="$config_home/nvim/lazy-lock.json"
[ -f "$lock_file" ] || ui_die "Missing $lock_file"

# Scratch space for the pinned lock and the verification output, removed on
# every exit. Neovim also runs from here so nothing can land in the cwd.
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/neovim-restore.XXXXXX")
trap 'rm -rf "$work_dir"' EXIT
pinned_lock="$work_dir/lazy-lock.json"
cp "$lock_file" "$pinned_lock"
rm -f "$UI_LOG_DIR/neovim-verify.log" # written by earlier versions of this script

lazy_restore() {
    (cd "$work_dir" && CHEZMOI_BOOTSTRAP=1 XDG_CONFIG_HOME="$config_home" \
        nvim --headless -i NONE "+Lazy! restore" +qa) >> "$UI_LOG_FILE" 2>&1 \
        || ui_die_log "Lazy restore failed"
}

ui_step "Restoring plugins from lazy-lock.json"
lazy_restore
# Installing missing plugins (a fresh machine, or a lock that adds plugins)
# makes lazy.nvim rewrite the lock from what is on disk between install
# rounds, dropping pins it has not seen yet, so those plugins land on their
# latest commit. Once everything is installed, a second pass applies every pin.
if ! cmp -s "$pinned_lock" "$lock_file"; then
    cp "$pinned_lock" "$lock_file"
    ui_step "Re-applying pins dropped while installing"
    lazy_restore
fi

# Verify against the pinned copy: lazy.nvim may have rewritten the deployed one.
verify_file="$work_dir/verify.log"
if ! python3 - "$pinned_lock" "$data_home/nvim/lazy" > "$verify_file" 2>&1 <<'PY'
import json
import pathlib
import shutil
import subprocess
import sys

lock_file = pathlib.Path(sys.argv[1])
plugin_root = pathlib.Path(sys.argv[2])
lock = json.loads(lock_file.read_text())
errors = []
skipped = []
conditional_requirements = {
    "markdown-preview.nvim": "node",
}

for name, spec in sorted(lock.items()):
    plugin_dir = plugin_root / name
    if not (plugin_dir / ".git").is_dir():
        requirement = conditional_requirements.get(name)
        if requirement and shutil.which(requirement) is None:
            skipped.append(f"{name} (missing optional command: {requirement})")
            continue
        errors.append(f"{name}: missing Git checkout")
        continue
    actual = subprocess.check_output(
        ["git", "-C", str(plugin_dir), "rev-parse", "HEAD"],
        text=True,
    ).strip()
    if actual != spec["commit"]:
        errors.append(f"{name}: {actual} != {spec['commit']}")

if errors:
    raise SystemExit("\n".join(errors))

for item in skipped:
    print(f"NEOVIM_OPTIONAL_SKIP={item}")
print(f"NEOVIM_LOCKS=PASS count={len(lock)} verified={len(lock) - len(skipped)} skipped={len(skipped)}")
PY

then
    cat "$verify_file" >> "$UI_LOG_FILE"
    ui_die_log "Neovim lock verification failed"
fi

cat "$verify_file" >> "$UI_LOG_FILE"
while IFS= read -r item; do
    case "$item" in
        NEOVIM_OPTIONAL_SKIP=*) ui_warn "Skipped ${item#NEOVIM_OPTIONAL_SKIP=}" ;;
    esac
done < "$verify_file"

summary=$(awk '/^NEOVIM_LOCKS=PASS / { print; exit }' "$verify_file")
[ -n "$summary" ] || ui_die_log "Neovim lock verification produced no summary"
total=$(printf '%s\n' "$summary" | sed -n 's/.*count=\([0-9][0-9]*\).*/\1/p')
verified=$(printf '%s\n' "$summary" | sed -n 's/.*verified=\([0-9][0-9]*\).*/\1/p')
skipped=$(printf '%s\n' "$summary" | sed -n 's/.*skipped=\([0-9][0-9]*\).*/\1/p')
ui_ok "Lock verified · $verified/$total plugins"

# Keep the managed lazy-lock.json identical to the repository.
if ! cmp -s "$pinned_lock" "$lock_file"; then
    cp "$pinned_lock" "$lock_file"
    ui_warn "lazy.nvim rewrote lazy-lock.json; restored the repository version"
fi

ui_done "Neovim ready · $verified verified · $skipped optional"
{{ end -}}
