# --- Ghostty Font Configuration ---

font-family = "Maple Mono NF CN"
font-size = 13
font-feature = calt
font-feature = liga

# --- Cursor Configuration ---

cursor-style = block_hollow

# --- Remote Shell Integration ---

shell-integration = detect
shell-integration-features = no-cursor,ssh-env,ssh-terminfo,no-sudo

# --- Mouse Control Configuration ---

mouse-shift-capture = never

# --- Background Configuration

background-opacity = 0.95
{{- if eq .chezmoi.os "linux" }}

# --- Keybind Configuration ---

# Linux only. With text selected, Ctrl + C copies it, like Cmd + C on macOS;
# otherwise Ctrl + C reaches the shell as usual. Paste stays Ctrl + Shift + V,
# because Ctrl + V is block selection in Vim and in tmux copy mode.
keybind = performable:ctrl+c=copy_to_clipboard
{{- end }}
